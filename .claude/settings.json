{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/.npmrc)",
      "Read(docs/.obsidian/**)",
      "Edit(docs/.obsidian/**)",

      "Edit(package.json)",
      "Edit(package-lock.json)",
      "Edit(.npmrc)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
     
      "Edit(tsconfig.json)",
      "Edit(eslint.config.*)",
      "Edit(postcss.config.*)",
      "Edit(.gitignore)",



      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm audit fix *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git rm *)",
      "Bash(git branch -D *)",
      "Bash(git config *)",
      "Bash(git apply *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(npm exec *)",
      "Bash(npm x *)",
      "Bash(npm rebuild *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",

      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git checkout *)",
      "PowerShell(git restore *)",
      "PowerShell(git stash *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm update *)",
      "PowerShell(npm audit fix *)",
      "PowerShell(git switch *)",
      "PowerShell(git merge *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git revert *)",
      "PowerShell(git rm *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git config *)",
      "PowerShell(git apply *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm add *)",
      "PowerShell(npm exec *)",
      "PowerShell(npm x *)",
      "PowerShell(npm rebuild *)",
      "PowerShell(pnpm *)",
      "PowerShell(yarn *)",
      "PowerShell(bun *)",
      "PowerShell(bunx *)",
